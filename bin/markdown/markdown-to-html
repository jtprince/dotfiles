#!/usr/bin/env ruby

require "open3"

options = [
  "--from=markdown+implicit_figures+smart",
  "--standalone",
  "--to=html5",
  "--variable=header-includes=<style>body{max-width:1200px;margin:auto;padding:0 2rem}</style>"
]

if ARGV.empty?
  warn "usage: #{File.basename(__FILE__)} <file>.md ..."
  exit 1
end

ARGV.each do |file|
  outfile = file.sub(/\.[^.]+\z/, "") + ".html"
  html, error, status = Open3.capture3("pandoc", *options, file)

  abort error unless status.success?
  File.write(outfile, html)
end