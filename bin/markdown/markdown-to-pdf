#!/usr/bin/env ruby

require 'shellwords'

# =============================================================================
# markdown-to-pdf: render markdown to PDF via pandoc + xelatex.
#
# The output is intended to look IDENTICAL on macOS and Linux, so the same
# font files are used on both platforms (same OTF/TTF, same rendering).
# The macOS system fonts (Helvetica Neue, Menlo) are NOT used, because they
# do not exist on Linux and would silently change the look there.
#
# Fonts used:
#   main  -> STIX Two Text
#   sans  -> Liberation Sans
#   mono  -> DejaVu Sans Mono
#
# Packages needed on each platform:
#
#   Linux (Arch/Manjaro):
#     yay -S otf-stix ttf-liberation ttf-dejavu
#     yay -S texlive-bin texlive-basic texlive-latex texlive-latexrecommended \
#            texlive-fontsrecommended texlive-pictures
#     yay -S texlive-latexextra     # provides tcolorbox.sty (head.tex dep)
######################################## WARNING ########################################
#     texlive-latexextra is ~118MB installed. tcolorbox is needed by head.tex.
##########################################################################################
#
#   macOS (Homebrew):
#     brew install --cask font-stix-two-text font-liberation font-dejavu
#     brew install --cask basictex 
#     if using basictex: tlmgr install latexmk fontspec tcolorbox newunicodechar
#     if using full mactex, tcolorbox is included.
#
# xelatex must be on PATH. Test with:  fc-list | grep -i stix
# =============================================================================

templates_dir = "#{Dir.home}/.local/share/pandoc/templates"
tex_header = "#{templates_dir}/head.tex"

# --smart gets me proper curly quotes and apostrophes!
# but they will not look right unless --standalone is also used

mainfont = "STIX Two Text"
sansfont = "Liberation Sans"
monofont = "DejaVu Sans Mono"

default_options = "-f markdown+smart --standalone -H #{tex_header} -V geometry:margin=1.25in -V fontsize=12pt -V mainfont='#{mainfont}' -V sansfont='#{sansfont}' -V monofont='#{monofont}' --variable urlcolor=NavyBlue --pdf-engine=xelatex"
# default_options = "-f markdown+smart --standalone -H #{tex_header} -V geometry:margin=1.25in -V fontsize=12pt --variable urlcolor=NavyBlue --pdf-engine=xelatex"
# default_options = "-f markdown+smart --standalone -H #{tex_header} -V geometry:margin=1.25in -V fontsize=12pt --variable urlcolor=NavyBlue --pdf-engine=xelatex --toc --toc-depth=2 --verbose"


#
#
# LANDSCAPE!!!
# default_options = "-f markdown+smart --standalone -V geometry:landscape --variable urlcolor=Blue --pdf-engine=xelatex"
# number sections:
#default_options = "--smart -N --standalone -V geometry:margin=1.7in --variable urlcolor=Blue"

if ARGV.size == 0
  puts "usage: #{File.basename(__FILE__)} [OPT] <file>.md ..."
  puts "outputs <file>.pdf ..."
  puts
  puts "options on by default: "
  puts "   #{default_options}"
  exit
end

ARGV.each do |file|
  base = file.chomp(File.extname(file))
  outfile = base + '.pdf'
  cmd = "pandoc #{default_options} #{Shellwords.escape(file)} -o #{Shellwords.escape(outfile)}"
  system cmd
end
