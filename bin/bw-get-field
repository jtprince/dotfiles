#!/usr/bin/env python

import argparse
import subprocess
import json
import sys

parser = argparse.ArgumentParser(description="Retrieve fields from a Bitwarden item.")
parser.add_argument("name", help="the name of the login/item")
parser.add_argument(
    "fields",
    nargs="*",
    help="the fields to retrieve (outputs value, one per line in order)",
)
args = parser.parse_args()


def is_unlocked_or_exit():
    result = subprocess.run(["bw", "unlock", "--check"], capture_output=True, text=True)
    if result.returncode == 1:
        print(
            "\n".join(
                ["hint:", "    bw login", "    export BW_SESSION=`bw unlock --raw`"]
            )
        )
        sys.exit(1)


def get_bw_item_exact(item_name: str) -> dict:
    """Retrieve the exact item by name."""
    result = subprocess.run(
        ["bw", "list", "items", "--search", item_name],
        capture_output=True,
        text=True,
        check=True,
    )

    items = json.loads(result.stdout)

    exact_matches = [item for item in items if item.get("name") == item_name]

    if not exact_matches:
        raise ValueError(f"No Bitwarden item found with exact name: '{item_name}'")
    if len(exact_matches) > 1:
        raise ValueError(f"Multiple items found with exact name: '{item_name}'")

    return exact_matches[0]


def get_field_value(item_data, field_name):
    # 1. Check custom fields
    custom_fields = item_data.get("fields", [])
    if isinstance(custom_fields, list):
        for f in custom_fields:
            if isinstance(f, dict) and f.get("name") == field_name:
                return f.get("value")

    # 2. Check standard login fields
    login_info = item_data.get("login", {})
    if isinstance(login_info, dict) and field_name in login_info:
        return login_info.get(field_name)

    # 3. Check root-level properties
    if field_name in item_data:
        return item_data.get(field_name)

    return None


def main():
    is_unlocked_or_exit()

    try:
        data = get_bw_item_exact(args.name)
    except subprocess.CalledProcessError as e:
        print(f"Error executing Bitwarden CLI: {e.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        print(
            "Error: 'bw' command not found. Ensure the Bitwarden CLI is installed and in your PATH.",
            file=sys.stderr,
        )
        sys.exit(1)
    except json.JSONDecodeError:
        print("Error: Failed to parse JSON output from Bitwarden CLI.", file=sys.stderr)
        sys.exit(1)
    except ValueError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    # Retrieve and print each requested field value
    if len(args.fields) == 0:
        for field_data in data["fields"]:
            print(f"{field_data['name']}: {field_data['value']}")
    else:
        for field in args.fields:
            val = get_field_value(data, field)
            if val is not None:
                print(val)
            else:
                print()


if __name__ == "__main__":
    main()
