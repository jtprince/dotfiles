#!/usr/bin/env python3
"""
dotfiles-configure — idempotent symlink manager for macOS and Linux.

Detects the current platform and creates the appropriate set of symlinks from
this dotfiles repo into $HOME and $HOME/.config. Platforms:

    mac        macOS laptop
    linux      personal Linux laptop (Arch/Manjaro)
    azure-vm   Azure work VM (Ubuntu); detected from the DMI chassis asset tag

Claude config (skills, hooks, CLAUDE.md) goes into ~/.claude and ~/.claude-personal
on macOS, ~/.claude-personal on Linux, and ~/.claude on an Azure VM. settings.json
is linked on macOS only.

On an Azure VM the run ends by printing the packages and installers still missing
and the command that switches the login shell to zsh.

Usage:
    dotfiles-configure              # apply links for current platform
    dotfiles-configure --dry        # preview without changing anything
    dotfiles-configure --platform azure-vm  # override platform detection
    dotfiles-configure --next-steps # Azure VM: print install steps only
    dotfiles-configure --clean-broken  # remove dangling symlinks in ~/.config
"""

from __future__ import annotations

import argparse
import os
import platform
import shutil
import subprocess
import textwrap
from dataclasses import dataclass
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

HOME = Path.home()
REPO_ROOT = Path(__file__).resolve().parent.parent
REPO_CONFIG = (REPO_ROOT / "config").resolve()
HOME_CONFIG = HOME / ".config"
DOT_LOCAL = HOME / ".local"
CLOUD_ENV = HOME / "Dropbox" / "env"

PLATFORMS = ("mac", "linux", "azure-vm")

# Every Azure VM reports this fixed DMI chassis asset tag. Local Hyper-V guests
# share the "Microsoft Corporation" vendor string but not this tag.
AZURE_ASSET_TAG = "7783-7084-3265-9085-8269-3286-77"
DMI_ASSET_TAG = Path("/sys/class/dmi/id/chassis_asset_tag")


def detect_platform() -> str:
    system = platform.system()
    if system == "Darwin":
        return "mac"
    if system == "Linux":
        try:
            if DMI_ASSET_TAG.read_text().strip() == AZURE_ASSET_TAG:
                return "azure-vm"
        except OSError:
            pass
        return "linux"
    raise SystemExit(f"unsupported platform: {system}")


# macOS hosts both work (~/.claude) and personal (~/.claude-personal, used via the
# `claude-personal` alias) Claude config dirs. The Linux laptop hosts only
# personal, and an Azure VM only work.
CLAUDE_DIRS: dict[str, list[Path]] = {
    "mac": [HOME / ".claude", HOME / ".claude-personal"],
    "linux": [HOME / ".claude-personal"],
    "azure-vm": [HOME / ".claude"],
}

# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Symlink:
    destination: Path
    link: Path
    backup: Path | None = None


# ---------------------------------------------------------------------------
# Config entries — symlinked into ~/.config/<name>
# ---------------------------------------------------------------------------

CONFIG_GENERAL = [
    "alacritty",
    "cheat",
    "cmux",
    "cursor-agent",
    "ghostty",
    "git",
    "ipython",
    "kitty",
    "nvim",
    "sheldon",
    "spotify-player",
    "starship.toml",
    "zsh",
    "mpv",
]

CONFIG_MAC = [
    "mac/amethyst",
    "mac/karabiner",
    "mac/osascript",
    "mac/uv",
]

CONFIG_LINUX = [
    # "linux/Xresources.d",
    # "linux/avizo",
    # "linux/dunst",
    "linux/feh",
    # "linux/fontconfig",
    # "linux/goofys",
    # "linux/gtk-3.0",
    # "linux/imv",
    "linux/latex",
    "linux/mako",
    # "linux/mimeapps.list",
    # "linux/mypy",
    # "linux/npmrc",
    # "linux/pipewire",
    # "linux/pulse",
    # "linux/pulseaudio-ctl",
    "linux/ranger",
    # "linux/spotify-flags.conf",
    # "linux/sway",
    # "linux/texlive",
    # "linux/tofi",
    # "linux/waybar",
    # "linux/xmodmap",
    "linux/uv",
]

# Azure VM: work-relevant, terminal-only configs. Replaces CONFIG_GENERAL.
CONFIG_AZURE_VM = [
    "cheat",
    "git",
    "ipython",
    "nvim",
    "sheldon",
    "starship.toml",
    "tmux",
    "zsh",
    "linux/uv",
]

# ---------------------------------------------------------------------------
# Home dotfiles — symlinked as ~/.<name>
# ---------------------------------------------------------------------------

HOME_DOTFILES_LINUX = [
    # "linux/xprofile",
    # "linux/xinitrc",
    # "linux/gtkrc-2.0",
]

# ---------------------------------------------------------------------------
# Explicit symlinks (destination -> link)
# ---------------------------------------------------------------------------

AGENT_SKILLS = [
    "link-check",
    "clear-technical-prose",
    "scientific-document-voice",
    "scientific-writing-voice",
    "markdown-slack",
    "markdown-reddit",
    "markdown-github",
    "markdown-discord",
    "markdown-obsidian",
    "plain-spec",
    "quoted-response",
]

EXPLICIT_SHELL: list[Symlink] = [
    Symlink(REPO_ROOT / "bin", link=HOME / "bin"),
    Symlink(REPO_CONFIG / "zsh/dot-zshenv", link=HOME / ".zshenv"),
    Symlink(REPO_CONFIG / "zsh/dot-zshrc", link=HOME / ".zshrc"),
    Symlink(REPO_CONFIG / "zsh/dot-zprofile", link=HOME / ".zprofile"),
]

EXPLICIT_GENERAL: list[Symlink] = [
    *EXPLICIT_SHELL,
    Symlink(REPO_CONFIG / "pandoc/data_dir", link=DOT_LOCAL / "share/pandoc"),
    *(
        Symlink(
            REPO_CONFIG / f"agent/skills/{name}", link=HOME / f".codex/skills/{name}"
        )
        for name in AGENT_SKILLS
    ),
    Symlink(REPO_CONFIG / "codex/AGENTS.md", link=HOME / ".codex/AGENTS.md"),
    Symlink(
        REPO_CONFIG / "codex/config.toml",
        link=HOME / ".codex/config.toml",
        backup=HOME / ".codex/backups/dotfiles-migration/config.toml",
    ),
    Symlink(REPO_CONFIG / "codex/hooks.json", link=HOME / ".codex/hooks.json"),
    Symlink(
        REPO_CONFIG / "codex/rules/default.rules",
        link=HOME / ".codex/rules/default.rules",
        backup=HOME / ".codex/backups/dotfiles-migration/default.rules",
    ),
]


def claude_links(claude_dirs: list[Path]) -> list[Symlink]:
    """Claude config (skills, hooks, CLAUDE.md), linked into every dir given."""
    return [
        link
        for claude_dir in claude_dirs
        for link in (
            *(
                Symlink(
                    REPO_CONFIG / f"agent/skills/{name}",
                    link=claude_dir / "skills" / name,
                )
                for name in AGENT_SKILLS
            ),
            Symlink(REPO_CONFIG / "claude/hooks", link=claude_dir / "hooks"),
            Symlink(REPO_CONFIG / "claude/CLAUDE.md", link=claude_dir / "CLAUDE.md"),
        )
    ]


EXPLICIT_MAC: list[Symlink] = [
    Symlink(REPO_CONFIG / "mac/hammerspoon", link=HOME / ".hammerspoon"),
    *(
        Symlink(REPO_CONFIG / "claude/settings.json", link=claude_dir / "settings.json")
        for claude_dir in CLAUDE_DIRS["mac"]
    ),
]

EXPLICIT_LINUX: list[Symlink] = [
    Symlink(CLOUD_ENV / "gpg/dot-gnupg", link=HOME / ".gnupg"),
    Symlink(
        REPO_CONFIG / "linux/mimeapps.list",
        link=DOT_LOCAL / "share/applications/mimeapps.list",
    ),
]

# ---------------------------------------------------------------------------
# Directories to ensure exist
# ---------------------------------------------------------------------------

ENSURE_DIRS_GENERAL: list[str] = []

ENSURE_DIRS_LINUX = [
    "npm",
    ".local/share/applications",
]

ENSURE_DIRS_AZURE_VM = [
    ".local/bin",
]


# ---------------------------------------------------------------------------
# Per-platform plan
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class PlatformLinks:
    dirs: list[str]
    config: list[str]
    home: list[str]
    explicit: list[Symlink]


def links_for(plat: str) -> PlatformLinks:
    claude = claude_links(CLAUDE_DIRS[plat])
    if plat == "mac":
        return PlatformLinks(
            dirs=list(ENSURE_DIRS_GENERAL),
            config=CONFIG_GENERAL + CONFIG_MAC,
            home=[],
            explicit=EXPLICIT_GENERAL + claude + EXPLICIT_MAC,
        )
    if plat == "linux":
        return PlatformLinks(
            dirs=ENSURE_DIRS_GENERAL + ENSURE_DIRS_LINUX,
            config=CONFIG_GENERAL + CONFIG_LINUX,
            home=list(HOME_DOTFILES_LINUX),
            explicit=EXPLICIT_GENERAL + claude + EXPLICIT_LINUX,
        )
    return PlatformLinks(
        dirs=ENSURE_DIRS_GENERAL + ENSURE_DIRS_AZURE_VM,
        config=list(CONFIG_AZURE_VM),
        home=[],
        explicit=EXPLICIT_SHELL + claude,
    )


# ---------------------------------------------------------------------------
# Azure VM next steps — packages and installers still missing
# ---------------------------------------------------------------------------

# apt package -> a command it provides (None: always list it).
APT_PACKAGES: dict[str, str | None] = {
    "zsh": "zsh",
    "tmux": "tmux",
    "kitty-terminfo": None,
    "git-delta": "delta",
    "ripgrep": "rg",
    "fd-find": "fdfind",
    "fzf": "fzf",
    "jq": "jq",
    "direnv": "direnv",
    "python3-argcomplete": "register-python-argcomplete",
    "curl": "curl",
    "unzip": "unzip",
    "build-essential": "make",
}

KITTY_TERMINFO = Path("/usr/share/terminfo/x/xterm-kitty")

NVIM_ARCH = {
    "x86_64": "x86_64",
    "amd64": "x86_64",
    "aarch64": "arm64",
    "arm64": "arm64",
}

LOCAL_INSTALLERS: dict[str, str] = {
    "uv": "curl -LsSf https://astral.sh/uv/install.sh | sh",
    "sheldon": (
        "curl --proto '=https' -fLsS https://rossmacarthur.github.io/install/crate.sh"
        " | bash -s -- --repo rossmacarthur/sheldon --to ~/.local/bin"
    ),
    "starship": "curl -sS https://starship.rs/install.sh | sh -s -- -y -b ~/.local/bin",
    "nvim": (
        "curl -fsSL https://github.com/neovim/neovim/releases/latest/download/"
        "nvim-linux-{arch}.tar.gz | tar -xz -C ~/.local --strip-components=1"
    ),
    "claude": "curl -fsSL https://claude.ai/install.sh | bash",
}

BASHRC_FALLBACK = """\
# Start zsh for interactive shells (chsh is unavailable for this login).
if [[ $- == *i* && -z $ZSH_VERSION ]] && command -v zsh >/dev/null; then
  SHELL="$(command -v zsh)" exec zsh -l
fi"""


def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None or (DOT_LOCAL / "bin" / cmd).exists()


def login_shell() -> tuple[str | None, bool]:
    """Return (login shell, whether the user is listed in /etc/passwd)."""
    import pwd

    try:
        entry = pwd.getpwuid(os.getuid())
    except KeyError:
        return None, False
    user, shell = entry.pw_name, entry.pw_shell
    try:
        local = any(
            line.split(":", 1)[0] == user
            for line in Path("/etc/passwd").read_text().splitlines()
        )
    except OSError:
        local = False
    return shell, local


def print_next_steps() -> None:
    print("\nNext steps (Azure VM) …")
    step = 0

    apt = [
        pkg
        for pkg, cmd in APT_PACKAGES.items()
        if (not have(cmd) if cmd else not KITTY_TERMINFO.exists())
    ]
    if apt:
        step += 1
        print(f"\n{step}. System packages:\n")
        print("   sudo apt-get update && sudo apt-get install -y " + " ".join(apt))

    arch = NVIM_ARCH.get(platform.machine().lower(), "x86_64")
    local = [
        cmd.format(arch=arch)
        for name, cmd in LOCAL_INSTALLERS.items()
        if not have(name)
    ]
    if local:
        step += 1
        print(f"\n{step}. User-local tools (no sudo):\n")
        print("   mkdir -p ~/.local/bin")
        for cmd in local:
            print(f"   {cmd}")

    shell, in_passwd = login_shell()
    if not (shell or "").endswith("/zsh"):
        step += 1
        print(f"\n{step}. Make zsh the login shell, then log out and back in:\n")
        if in_passwd:
            print('   sudo chsh -s "$(command -v zsh)" "$USER"')
        else:
            print("   This login is not in /etc/passwd (Entra ID), so chsh will fail.")
            print("   Append this to ~/.bashrc instead:\n")
            print(textwrap.indent(BASHRC_FALLBACK, "   "))

    if not step:
        print("  (nothing missing)")
    else:
        print("\nThen start work with: tmux new -As default")


# ---------------------------------------------------------------------------
# Git filters — strip ephemeral keys (e.g. Claude's `model` picker) from
# tracked config before they hit git's object store, without touching the
# live file on disk. See config/claude/settings.json + .gitattributes.
# ---------------------------------------------------------------------------

GIT_FILTERS: dict[str, str] = {
    "claude-settings.clean": 'jq "del(.model, .effortLevel, .modelSettings)"',
    "codex-config.clean": "python3 config/codex/clean-config.py",
    # `required` guards the clean side so machine-local state can never slip
    # into the object store silently. It also makes git refuse to smudge unless
    # a command exists, which breaks any checkout/merge touching config.toml —
    # so declare an explicit pass-through for the smudge direction.
    "codex-config.smudge": "cat",
    "codex-config.required": "true",
}


def configure_git_filters(dry: bool = False) -> None:
    print("\nConfiguring git filters …")
    for key, value in GIT_FILTERS.items():
        print(f"  git config filter.{key} '{value}'")
        if not dry:
            subprocess.run(
                ["git", "config", f"filter.{key}", value],
                cwd=REPO_ROOT,
                check=True,
            )


# ---------------------------------------------------------------------------
# Symlinker
# ---------------------------------------------------------------------------


class Symlinker:
    def __init__(self, dry: bool = False):
        self.dry = dry

    def ensure_link(self, symlink: Symlink) -> None:
        if symlink.link.is_symlink():
            if symlink.link.resolve() == symlink.destination.resolve():
                print(f"  ✓ {symlink.link} -> {symlink.destination}")
                return
            print(f"  ✗ removing stale link: {symlink.link}")
            if not self.dry:
                symlink.link.unlink()
        elif symlink.link.exists():
            if symlink.backup is not None and not symlink.backup.exists():
                print(f"  ↳ backup {symlink.link} -> {symlink.backup}")
                if not self.dry:
                    symlink.backup.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(symlink.link, symlink.backup)
            print(f"  ✗ removing real path: {symlink.link}")
            if not self.dry:
                if symlink.link.is_dir():
                    shutil.rmtree(symlink.link)
                else:
                    symlink.link.unlink()

        print(f"  → ln -s {symlink.destination} {symlink.link}")
        if not self.dry:
            symlink.link.parent.mkdir(parents=True, exist_ok=True)
            symlink.link.symlink_to(symlink.destination)

    def ensure_links(self, symlinks: list[Symlink]) -> None:
        for s in symlinks:
            self.ensure_link(s)

    def link_into_config(self, names: list[str]) -> None:
        for name in names:
            link_name = Path(name).name
            self.ensure_link(Symlink(REPO_CONFIG / name, link=HOME_CONFIG / link_name))

    def link_into_home(self, names: list[str]) -> None:
        for name in names:
            link_name = Path(name).name
            self.ensure_link(Symlink(REPO_CONFIG / name, link=HOME / f".{link_name}"))

    def ensure_dirs(self, dirs: list[str]) -> None:
        for name in dirs:
            path = HOME / name
            print(f"  mkdir -p {path}")
            if not self.dry:
                path.mkdir(parents=True, exist_ok=True)


# ---------------------------------------------------------------------------
# Broken-link cleanup
# ---------------------------------------------------------------------------


def clean_broken_symlinks(dry: bool = False) -> None:
    """Remove dangling symlinks in ~/.config."""
    print("\nCleaning broken symlinks in ~/.config …")
    found = False
    for child in sorted(HOME_CONFIG.iterdir()):
        if child.is_symlink() and not child.resolve().exists():
            found = True
            print(f"  ✗ broken: {child} -> {child.readlink()}")
            if not dry:
                child.unlink()
    if not found:
        print("  (none found)")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Idempotent dotfile symlink manager (macOS + Linux + Azure VM).",
    )
    parser.add_argument("--dry", action="store_true", help="preview without changes")
    parser.add_argument(
        "--platform",
        choices=PLATFORMS,
        help="override platform detection",
    )
    parser.add_argument(
        "--next-steps",
        action="store_true",
        help="Azure VM: print missing packages and installers, then exit",
    )
    parser.add_argument(
        "--clean-broken",
        action="store_true",
        help="remove dangling symlinks in ~/.config",
    )

    return parser


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    linker = Symlinker(dry=args.dry)
    prefix = "[DRY RUN] " if args.dry else ""

    if args.clean_broken:
        clean_broken_symlinks(dry=args.dry)
        return

    plat = args.platform or detect_platform()

    if args.next_steps:
        print_next_steps()
        return

    print(f"{prefix}Platform: {plat}")
    plan = links_for(plat)

    configure_git_filters(dry=args.dry)

    # -- Directories --------------------------------------------------------
    if plan.dirs:
        print(f"{prefix}Ensuring directories …")
        linker.ensure_dirs(plan.dirs)

    # -- ~/.config links ----------------------------------------------------
    print(f"\n{prefix}Linking into ~/.config …")
    linker.link_into_config(plan.config)

    # -- ~/.<name> home dotfiles --------------------------------------------
    if plan.home:
        print(f"\n{prefix}Linking home dotfiles …")
        linker.link_into_home(plan.home)

    # -- Explicit symlinks --------------------------------------------------
    print(f"\n{prefix}Explicit symlinks …")
    linker.ensure_links(plan.explicit)

    if plat == "azure-vm":
        print_next_steps()


if __name__ == "__main__":
    main()
