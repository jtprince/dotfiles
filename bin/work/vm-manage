#!/usr/bin/env bash
# vm-manage: start, stop, and check an Azure VM by name. Run `vm-manage --help`.
set -euo pipefail

# --- Config ---
SUBSCRIPTION="${VM_MANAGE_SUBSCRIPTION:-sub-enveda-data-dev-01}"
CMD="${1:-}"
VM_NAME="${2:-${VM_MANAGE_DEFAULT_VM:-}}"
RESOURCE_GROUP="${VM_MANAGE_RESOURCE_GROUP:-}"

# --- Helpers ---
err() { printf "ERROR: %s\n" "$*" >&2; }
log() { printf "%s\n" "$*"; }

require_az() {
  if ! command -v az >/dev/null 2>&1; then
    err "Azure CLI (az) not found. Install from https://aka.ms/azcli"
    exit 127
  fi
}

# Check a VM name was given, then find its resource group unless one was set.
require_vm() {
  if [[ -z "$VM_NAME" ]]; then
    err "no VM name; pass one (vm-manage $CMD <vm-name>) or set VM_MANAGE_DEFAULT_VM"
    err "list VMs with: vm-manage list"
    exit 2
  fi
  [[ -n "$RESOURCE_GROUP" ]] && return 0
  RESOURCE_GROUP="$(
    az vm list \
      --subscription "$SUBSCRIPTION" \
      --only-show-errors \
      --query "[?name=='$VM_NAME'].resourceGroup | [0]" \
      -o tsv
  )" || {
    err "could not list VMs in $SUBSCRIPTION; are you logged in? (az-login or az login)"
    exit 1
  }
  if [[ -z "$RESOURCE_GROUP" ]]; then
    err "VM '$VM_NAME' not found in subscription $SUBSCRIPTION; list VMs with: vm-manage list"
    exit 2
  fi
}

power_state() {
  az vm get-instance-view \
    --resource-group "$RESOURCE_GROUP" \
    --name "$VM_NAME" \
    --subscription "$SUBSCRIPTION" \
    --query "instanceView.statuses[?starts_with(code, 'PowerState/')].displayStatus | [0]" \
    -o tsv 2>/dev/null || true
}

wait_for_state() {
  local desired="$1" ; local timeout="${2:-600}" ; local interval=5
  local start end now
  start=$(date +%s)
  end=$((start + timeout))
  while true; do
    now=$(date +%s)
    local state
    state="$(power_state)"
    if [[ "$state" == "$desired" ]]; then
      log "✅ Reached desired state: $state"
      return 0
    fi
    if (( now >= end )); then
      err "Timed out waiting for state '$desired'. Last seen: '${state:-unknown}'"
      return 1
    fi
    log "Waiting for '$desired' (current: '${state:-unknown}')..."
    sleep "$interval"
  done
}

usage() {
  cat <<USAGE
Usage: $(basename "$0") {list|login|logout|start|stop|stop-only|deallocate|status} [VM-NAME]

Commands:
  list                  List VMs in the subscription with their power state
  login                 az login (resource manager scope)
  logout                az logout
  start                 Start VM
  stop                  Fully stop and deallocate (no compute charges)
  stop-only             Power off without deallocating (still billed for compute)
  deallocate            Deallocate explicitly (alias to 'stop' behavior)
  status                Show power state and IPs

Environment:
  VM_MANAGE_DEFAULT_VM       VM to use when VM-NAME is omitted
  VM_MANAGE_SUBSCRIPTION     Subscription (default: sub-enveda-data-dev-01)
  VM_MANAGE_RESOURCE_GROUP   Resource group (default: looked up from the VM name)
USAGE
}

# --- Entry ---
case "$CMD" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
esac

require_az

case "$CMD" in
  login)
    # If device code is preferred, uncomment the next line and comment the one after.
    # az login --scope "https://management.core.windows.net//.default" --use-device-code
    az login --scope "https://management.core.windows.net//.default"
    ;;

  logout)
    az logout
    ;;

  list)
    az vm list -d \
      --subscription "$SUBSCRIPTION" \
      --only-show-errors \
      --query "sort_by([], &name)[].{Name:name, ResourceGroup:resourceGroup, Power:powerState}" \
      -o table
    ;;

  start)
    require_vm
    log "Starting VM '$VM_NAME' in resource group '$RESOURCE_GROUP'..."
    az vm start --resource-group "$RESOURCE_GROUP" --name "$VM_NAME" --subscription "$SUBSCRIPTION" >/dev/null
    wait_for_state "VM running" 600
    ;;

  stop|deallocate)
    require_vm
    log "Deallocating VM '$VM_NAME' in resource group '$RESOURCE_GROUP' (releases compute resources)..."
    # 'deallocate' is enough; it transitions to 'VM deallocated'
    az vm deallocate --resource-group "$RESOURCE_GROUP" --name "$VM_NAME" --subscription "$SUBSCRIPTION" >/dev/null
    wait_for_state "VM deallocated" 900
    ;;

  stop-only)
    require_vm
    log "Powering off (NOT deallocating) VM '$VM_NAME' in resource group '$RESOURCE_GROUP'..."
    az vm stop --resource-group "$RESOURCE_GROUP" --name "$VM_NAME" --subscription "$SUBSCRIPTION" >/dev/null
    wait_for_state "VM stopped" 600
    ;;

  status)
    require_vm
    log "Checking status of VM '$VM_NAME' in resource group '$RESOURCE_GROUP'..."
    az vm get-instance-view \
      --resource-group "$RESOURCE_GROUP" \
      --name "$VM_NAME" \
      --subscription "$SUBSCRIPTION" \
      --query "instanceView.statuses[?code!='ProvisioningState/succeeded'].{Status:displayStatus}" \
      --output table
    az vm list-ip-addresses \
      --resource-group "$RESOURCE_GROUP" \
      --name "$VM_NAME" \
      --subscription "$SUBSCRIPTION" \
      --query "[].{PublicIP:virtualMachine.network.publicIpAddresses[0].ipAddress, PrivateIP:virtualMachine.network.privateIpAddresses[0]}" \
      --output table
    ;;

  *)
    usage
    exit 1
    ;;
esac
