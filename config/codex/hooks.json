{
  "hooks" : {
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "c='\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso'; [ -x \"$c\" ] || c=\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso; \"$c\" codex-hook PermissionRequest; : # __keepresso_codex_hook",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "c='\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso'; [ -x \"$c\" ] || c=\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso; \"$c\" codex-hook PostToolUse; : # __keepresso_codex_hook",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "serena-hooks remind --client=codex",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "serena-hooks auto-approve --client=codex",
            "type" : "command"
          }
        ],
        "matcher" : "^mcp__serena__.*"
      },
      {
        "hooks" : [
          {
            "command" : "c='\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso'; [ -x \"$c\" ] || c=\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso; \"$c\" codex-hook PreToolUse; : # __keepresso_codex_hook",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "c='\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso'; [ -x \"$c\" ] || c=\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso; \"$c\" codex-hook SessionEnd; : # __keepresso_codex_hook",
            "timeout" : 3,
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "serena-hooks activate --client=codex",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "c='\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso'; [ -x \"$c\" ] || c=\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso; \"$c\" codex-hook SessionStart; : # __keepresso_codex_hook",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "c='\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso'; [ -x \"$c\" ] || c=\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso; \"$c\" codex-hook Stop; : # __keepresso_codex_hook",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "c='\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso'; [ -x \"$c\" ] || c=\/Applications\/Keepresso.app\/Contents\/Helpers\/keepresso; \"$c\" codex-hook UserPromptSubmit; : # __keepresso_codex_hook",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ]
  }
}
