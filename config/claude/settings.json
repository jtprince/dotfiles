{
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "caveman@caveman": false,
    "code-review@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "enveda-databricks@enveda-ai-plugin-marketplace": true,
    "enveda-documentation@enveda-ai-plugin-marketplace": true,
    "enveda-kr-posts@enveda-ai-plugin-marketplace": true,
    "enveda-peptidomics@peptidomics-ai-plugin-marketplace": true,
    "enveda-prefect@enveda-ai-plugin-marketplace": true,
    "enveda-python@enveda-ai-plugin-marketplace": true,
    "enveda-reusable-workflows@enveda-ai-plugin-marketplace": true,
    "enveda-setup@enveda-ai-plugin-marketplace": true,
    "enveda-ui-ux@enveda-ai-plugin-marketplace": true,
    "enveda-vibe-coding@enveda-ai-plugin-marketplace": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "context-mode": {
      "source": {
        "repo": "mksglu/context-mode",
        "source": "github"
      }
    },
    "peptidomics-ai-plugin-marketplace": {
      "source": {
        "path": "/Users/johnprince/projects/peptidomics-ai-plugin-marketplace",
        "source": "directory"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "kitty-agent-attention",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "c='/Applications/Keepresso.app/Contents/Helpers/keepresso'; [ -x \"$c\" ] || c=/Applications/Keepresso.app/Contents/Helpers/keepresso; \"$c\" agent-hook Notification; : # __keepresso_hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "c='/Applications/Keepresso.app/Contents/Helpers/keepresso'; [ -x \"$c\" ] || c=/Applications/Keepresso.app/Contents/Helpers/keepresso; \"$c\" agent-hook PermissionRequest; : # __keepresso_hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "cavemem hook run post-tool-use --ide claude-code",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "c='/Applications/Keepresso.app/Contents/Helpers/keepresso'; [ -x \"$c\" ] || c=/Applications/Keepresso.app/Contents/Helpers/keepresso; \"$c\" agent-hook PostToolUse; : # __keepresso_hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/no-blanket-git-add.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "serena-hooks remind --client=claude-code",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "serena-hooks auto-approve --client=claude-code",
            "type": "command"
          }
        ],
        "matcher": "mcp__serena__*"
      },
      {
        "hooks": [
          {
            "command": "c='/Applications/Keepresso.app/Contents/Helpers/keepresso'; [ -x \"$c\" ] || c=/Applications/Keepresso.app/Contents/Helpers/keepresso; \"$c\" agent-hook PreToolUse; : # __keepresso_hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "cavemem hook run session-end --ide claude-code",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "serena-hooks cleanup --client=claude-code",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "c='/Applications/Keepresso.app/Contents/Helpers/keepresso'; [ -x \"$c\" ] || c=/Applications/Keepresso.app/Contents/Helpers/keepresso; \"$c\" agent-hook SessionEnd; : # __keepresso_hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/strip-rtk-hook.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "cavemem hook run session-start --ide claude-code",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "serena-hooks activate --client=claude-code",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "\"/Users/johnprince/.claude/hooks/context-mode-cache-heal.mjs\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "c='/Applications/Keepresso.app/Contents/Helpers/keepresso'; [ -x \"$c\" ] || c=/Applications/Keepresso.app/Contents/Helpers/keepresso; \"$c\" agent-hook SessionStart; : # __keepresso_hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "cavemem hook run stop --ide claude-code",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "kitty-agent-attention",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "c='/Applications/Keepresso.app/Contents/Helpers/keepresso'; [ -x \"$c\" ] || c=/Applications/Keepresso.app/Contents/Helpers/keepresso; \"$c\" agent-hook Stop; : # __keepresso_hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "cavemem hook run user-prompt-submit --ide claude-code",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "c='/Applications/Keepresso.app/Contents/Helpers/keepresso'; [ -x \"$c\" ] || c=/Applications/Keepresso.app/Contents/Helpers/keepresso; \"$c\" agent-hook UserPromptSubmit; : # __keepresso_hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "cavemem": {
      "args": [
        "mcp"
      ],
      "command": "cavemem"
    }
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen",
  "verbose": true
}
